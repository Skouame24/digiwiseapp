# Configuration SMTP pour l'envoi de mails de contact
SMTP_HOST="mail.ambracloud.net" # ou smtp.gmail.com / smtp.office365.com
SMTP_PORT=587 # 587 (TLS) ou 465 (SSL)
SMTP_USER="infos@ambracloud.net" # Votre adresse d'envoi ou compte SMTP
SMTP_PASS="VOTRE_MOT_DE_PASSE_SMTP" # Mot de passe ou mot de passe d'application
SMTP_SECURE=false # true pour port 465, false pour port 587

# Adresse e-mail destinataire qui recevra les formulaires de contact
CONTACT_RECEIVER_EMAIL="infos@ambracloud.net"
